                    </div>

                    <!-- Action Control Buttons -->
                    <div class="flex items-center gap-2">
                        <button onclick="clearSequence()" class="px-2.5 py-2 bg-stone-800 hover:bg-stone-700 text-xs text-rose-300 rounded-lg border border-rose-900/40 transition">
