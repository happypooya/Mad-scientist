            { id: 'darwin', name: 'Charles Darwin', role: 'Biologist', bio: 'Pioneer of evolution and natural selection.', image: 'https://raw.githubusercontent.com/happypooya/Mad-scientist/refs/heads/main/Darwin.jpg' },
