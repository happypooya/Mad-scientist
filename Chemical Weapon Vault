                        <button id="btnUnlock" onclick="verifySequence()" class="px-4 py-2 bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-stone-950 font-bold text-xs sm:text-sm rounded-lg shadow-lg shadow-amber-600/30 transition transform active:scale-95 flex items-center gap-1.5">
                            <i class="fa-solid fa-lock-open"></i> Unlock
