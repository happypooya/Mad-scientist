    <script>
        // Target Solution Sequence
        const CORRECT_SEQUENCE = ['darwin', 'michael_jackson', 'einstein', 'shakespeare', 'van_gogh'];
        
        let selectedSequence = []; // Holds user-selected IDs in order
        let isAudioMuted = false;
        let isSolved = false;

        // Character Clues mapping for AI
        const AI_CLUES = {
            darwin: { name: "Charles Darwin", hint: "The naturalist who discovered natural selection." },
            michael_jackson: { name: "Michael Jackson", hint: "The legendary King of Pop music." },
            einstein: { name: "Albert Einstein", hint: "The physicist who formulated relativity." },
            shakespeare: { name: "William Shakespeare", hint: "The immortal playwright and bard." },
            van_gogh: { name: "Vincent van Gogh", hint: "The post-impressionist master of expressive art." }
        };

        // All 17 Luminaries with custom image URLs
        const CHARACTERS = [
            { id: 'bach', name: 'Johann Sebastian Bach', role: 'Baroque Composer', bio: 'The towering genius of baroque music.', image: 'https://raw.githubusercontent.com/happypooya/Mad-scientist/refs/heads/main/Bach.jpg' },
            { id: 'beethoven', name: 'Ludwig van Beethoven', role: 'Classical Composer', bio: 'The deaf maestro of classical symphonies.', image: 'https://raw.githubusercontent.com/happypooya/Mad-scientist/refs/heads/main/Beethoven.jpg' },
            { id: 'dali', name: 'Salvador Dalí', role: 'Surrealist Painter', bio: 'Master of dreamlike surrealist art.', image: 'https://raw.githubusercontent.com/happypooya/Mad-scientist/refs/heads/main/Dali.jpg' },
