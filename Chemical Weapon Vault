                    </div>
                </div>
            </div>

            <!-- Quick AI Prompt Buttons -->
            <div class="grid grid-cols-2 gap-1.5 mb-2">
                <button onclick="aiAnalyzePedestal()" class="p-1.5 bg-blue-900/40 hover:bg-blue-800/60 text-blue-200 text-[11px] rounded-lg border border-blue-700/40 transition text-left flex items-center space-x-1">
