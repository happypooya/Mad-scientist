        // Sound Synthesis Helper (Web Audio API)
        class SoundFX {
            constructor() { this.ctx = null; }
            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                }
            }
            playClick() {
                if (isAudioMuted) return;
                try {
                    this.init();
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(440, this.ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(880, this.ctx.currentTime + 0.08);
                    gain.gain.setValueAtTime(0.1, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.08);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start();
                    osc.stop(this.ctx.currentTime + 0.08);
                } catch(e) {}
            }
            playSuccess() {
                if (isAudioMuted) return;
                try {
                    this.init();
                    [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
                        const osc = this.ctx.createOscillator();
                        const gain = this.ctx.createGain();
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(freq, this.ctx.currentTime + i * 0.12);
                        gain.gain.setValueAtTime(0.12, this.ctx.currentTime + i * 0.12);
                        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + i * 0.12 + 0.3);
                        osc.connect(gain);
                        gain.connect(this.ctx.destination);
                        osc.start(this.ctx.currentTime + i * 0.12);
                        osc.stop(this.ctx.currentTime + i * 0.12 + 0.3);
                    });
                } catch(e) {}
            }
            playError() {
                if (isAudioMuted) return;
                try {
                    this.init();
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(180, this.ctx.currentTime);
                    osc.frequency.setValueAtTime(130, this.ctx.currentTime + 0.15);
                    gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.35);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start();
                    osc.stop(this.ctx.currentTime + 0.35);
                } catch(e) {}
            }
        }

        const audioFX = new SoundFX();

        function toggleAudio() {
            isAudioMuted = !isAudioMuted;
            const btn = document.getElementById('btnSoundToggle');
            const icon = document.getElementById('soundIcon');
            const label = document.getElementById('soundLabel');
            if (isAudioMuted) {
                icon.className = 'fa-solid fa-volume-xmark';
                if(label) label.textContent = 'Muted';
                btn.classList.add('opacity-70');
            } else {
                icon.className = 'fa-solid fa-volume-high';
                if(label) label.textContent = 'Audio';
                btn.classList.remove('opacity-70');
                audioFX.playClick();
            }
        }

        // Shuffle portraits randomly
        function shuffleArray(array) {
            let arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        let randomizedPortraits = [];

        function renderPortraits() {
            if (randomizedPortraits.length === 0) {
                randomizedPortraits = shuffleArray(CHARACTERS);
            }

            const grid = document.getElementById('portraitsGrid');
            if (!grid) return;
            grid.innerHTML = '';

            randomizedPortraits.forEach(char => {
                const isSelected = selectedSequence.includes(char.id);
                const div = document.createElement('div');
                div.className = `picture-frame w-14 h-20 sm:w-18 sm:h-24 md:w-22 md:h-30 flex flex-col items-center justify-between p-1 relative ${isSelected ? 'in-slot' : ''}`;
                div.setAttribute('data-id', char.id);
                div.onclick = () => handlePortraitClick(char.id);

                div.innerHTML = `
                    <div class="inner-canvas w-full h-full relative overflow-hidden flex items-center justify-center">
                        <img src="${char.image}" alt="${char.name}" class="w-full h-full object-cover pointer-events-none" onerror="this.src='https://placehold.co/120x160/2a1a08/d4af37?text=${encodeURIComponent(char.name.split(' ').pop())}'">
                    </div>
                    <span class="text-[8px] sm:text-[9px] font-cinzel text-amber-200 text-center truncate w-full mt-0.5">${char.name.split(' ').pop()}</span>
                `;
                grid.appendChild(div);
            });

            renderPedestal();
        }

        function renderPedestal() {
            for (let i = 0; i < 5; i++) {
                const slotEl = document.querySelector(`.pedestal-slot[data-slot="${i}"]`);
                if (!slotEl) continue;
                const contentEl = slotEl.querySelector('.slot-content');
                
                if (selectedSequence[i]) {
                    const charId = selectedSequence[i];
                    const char = CHARACTERS.find(c => c.id === charId);
                    contentEl.innerHTML = `
                        <div class="w-full h-full relative flex flex-col items-center justify-center group">
                            <img src="${char.image}" alt="${char.name}" class="w-full h-full object-cover rounded border border-amber-600/70 shadow">
                            <button onclick="event.stopPropagation(); removeFromPedestal(${i})" class="absolute -top-1 -right-1 bg-rose-700 hover:bg-rose-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] shadow-lg border border-rose-400 z-10">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    `;
                } else {
                    contentEl.innerHTML = `
                        <div class="w-full h-full flex items-center justify-center text-amber-500/30 text-xs font-mono">
                            <i class="fa-solid fa-plus opacity-40"></i>
                        </div>
                    `;
                }
            }
        }

        function handlePortraitClick(charId) {
            audioFX.playClick();
            if (selectedSequence.includes(charId)) {
                showToast("Already placed on the pedestal!");
                return;
            }

            if (selectedSequence.length >= 5) {
                showToast("Pedestal is full (5/5). Clear a slot or unlock!");
                return;
            }

            selectedSequence.push(charId);
            renderPortraits();
        }

        function handleSlotClick(index) {
            audioFX.playClick();
            if (selectedSequence[index]) {
                removeFromPedestal(index);
            } else {
                showToast(`Tap any portrait on the wall for slot #${index + 1}`);
            }
        }

        function removeFromPedestal(index) {
            audioFX.playClick();
            selectedSequence.splice(index, 1);
            renderPortraits();
        }

        function clearSequence() {
            audioFX.playClick();
            selectedSequence = [];
            renderPortraits();
            showToast("Pedestal cleared.");
        }

        function resetPuzzle() {
            audioFX.playClick();
            selectedSequence = [];
            isSolved = false;
            randomizedPortraits = shuffleArray(CHARACTERS);
            
            const wallLeft = document.getElementById('wallLeft');
            if (wallLeft) wallLeft.classList.remove('open');

            const video = document.getElementById('vaultVideo');
            if (video) {
                video.pause();
                video.currentTime = 0;
            }

            const statusMsg = document.getElementById('vaultStatusMessage');
            if (statusMsg) statusMsg.style.opacity = '0';

            renderPortraits();
            showToast("Puzzle reset!");
        }

        function verifySequence() {
            audioFX.playClick();
            if (selectedSequence.length < 5) {
                audioFX.playError();
                showToast("Please place all 5 portraits first!");
                return;
            }

            let isCorrect = true;
            for (let i = 0; i < 5; i++) {
                if (selectedSequence[i] !== CORRECT_SEQUENCE[i]) {
                    isCorrect = false;
                    break;
                }
            }

            if (isCorrect) {
                isSolved = true;
                audioFX.playSuccess();
                triggerVaultOpen();
            } else {
                audioFX.playError();
                showToast("Incorrect sequence! Check Journal or ask AI.");
            }
        }

        function triggerVaultOpen() {
            const wallLeft = document.getElementById('wallLeft');
            if (wallLeft) wallLeft.classList.add('open');

            const statusMsg = document.getElementById('vaultStatusMessage');
            if (statusMsg) statusMsg.style.opacity = '1';

            const video = document.getElementById('vaultVideo');
            if (video) {
                video.currentTime = 0;
                video.play().catch(e => console.log(e));
            }

            showToast("Vault unlocked successfully!");
        }

        // AI Assistant functions
        function toggleAiDrawer() {
            audioFX.playClick();
            const modal = document.getElementById('aiDrawerModal');
            if (modal) {
                if (modal.classList.contains('opacity-0')) {
                    modal.classList.remove('opacity-0', 'pointer-events-none');
                } else {
                    modal.classList.add('opacity-0', 'pointer-events-none');
                }
            }
        }

        function toggleJournalModal() {
            audioFX.playClick();
            const modal = document.getElementById('journalModal');
            if (modal) {
                if (modal.classList.contains('opacity-0')) {
                    modal.classList.remove('opacity-0', 'pointer-events-none');
                } else {
                    modal.classList.add('opacity-0', 'pointer-events-none');
                }
            }
        }

        function appendAiMessage(sender, text) {
            const chatLog = document.getElementById('aiChatLog');
            if (!chatLog) return;
            const div = document.createElement('div');
            div.className = `flex items-start space-x-2 ${sender === 'user' ? 'justify-end' : ''}`;
            
            if (sender === 'ai') {
                div.innerHTML = `
                    <div class="w-5 h-5 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div class="bg-blue-950/80 border border-blue-800/50 text-blue-100 p-2 rounded-lg rounded-tl-none max-w-[90%] leading-relaxed text-xs">
                        ${text}
                    </div>
                `;
            } else {
                div.innerHTML = `
                    <div class="bg-blue-800/60 text-slate-100 p-2 rounded-lg rounded-tr-none max-w-[90%] leading-relaxed text-xs">
                        ${text}
                    </div>
                `;
            }
            chatLog.appendChild(div);
            chatLog.scrollTop = chatLog.scrollHeight;
        }

        function aiAnalyzePedestal() {
            audioFX.playClick();
            if (selectedSequence.length === 0) {
                appendAiMessage('ai', "Your pedestal is completely empty! You need to place 5 figures in order.");
                return;
            }
            let correctCount = 0;
            let feedback = `You have placed ${selectedSequence.length}/5 figures. `;
            for (let i = 0; i < selectedSequence.length; i++) {
                if (selectedSequence[i] === CORRECT_SEQUENCE[i]) {
                    correctCount++;
                }
            }
            feedback += `Out of these, <strong>${correctCount}</strong> are in the correct slot position!`;
            appendAiMessage('ai', feedback);
        }

        function aiGiveNextHint() {
            audioFX.playClick();
            // Find first incorrect or missing
            for (let i = 0; i < 5; i++) {
                if (!selectedSequence[i]) {
                    const targetId = CORRECT_SEQUENCE[i];
                    appendAiMessage('ai', `Hint for slot #${i + 1}: It is <strong>${AI_CLUES[targetId].name}</strong> — ${AI_CLUES[targetId].hint}`);
                    return;
                }
                if (selectedSequence[i] !== CORRECT_SEQUENCE[i]) {
                    appendAiMessage('ai', `Notice: Slot #${i + 1} (${CHARACTERS.find(c => c.id === selectedSequence[i]).name}) is incorrect. Look for someone else!`);
                    return;
                }
            }
            appendAiMessage('ai', "All 5 slots look correct! Tap the 'Unlock' button to open the vault.");
        }

        function sendAiMessage() {
            const input = document.getElementById('aiUserInput');
            if (!input || !input.value.trim()) return;
            const userText = input.value.trim();
            appendAiMessage('user', userText);
            input.value = '';

            setTimeout(() => {
                const lower = userText.toLowerCase();
                if (lower.includes('why') || lower.includes('need') || lower.includes('help')) {
                    appendAiMessage('ai', "I am your AI Curator! I guide you through the historical puzzles, give subtle hints, and analyze your pedestal so you don't get stuck.");
                } else if (lower.includes('slot 1') || lower.includes('first')) {
                    appendAiMessage('ai', `Slot #1 clue: ${AI_CLUES['darwin'].hint}`);
                } else if (lower.includes('slot 2') || lower.includes('second')) {
                    appendAiMessage('ai', `Slot #2 clue: ${AI_CLUES['michael_jackson'].hint}`);
                } else if (lower.includes('slot 3') || lower.includes('third')) {
                    appendAiMessage('ai', `Slot #3 clue: ${AI_CLUES['einstein'].hint}`);
                } else if (lower.includes('slot 4') || lower.includes('fourth')) {
                    appendAiMessage('ai', `Slot #4 clue: ${AI_CLUES['shakespeare'].hint}`);
                } else if (lower.includes('slot 5') || lower.includes('fifth')) {
                    appendAiMessage('ai', `Slot #5 clue: ${AI_CLUES['van_gogh'].hint}`);
                } else {
                    appendAiMessage('ai', "That's a fascinating question! Remember the 5 pillars: Biology, Music, Physics, Literature, and Art. Try asking 'Analyze Pedestal' or 'Next Step Clue'!");
                }
            }, 600);
        }

        function showToast(message) {
            const toast = document.getElementById('toastMessage');
            const text = document.getElementById('toastText');
            if (!toast || !text) return;
            text.textContent = message;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 3000);
        }

        // Initialize on window load
        window.onload = function() {
            renderPortraits();
        };
    </script>
