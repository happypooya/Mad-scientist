    <!-- Status Toast / Feedback Banner -->
    <div id="toastMessage" class="fixed bottom-14 left-1/2 transform -translate-x-1/2 z-40 opacity-0 pointer-events-none transition-all duration-300 bg-stone-900/95 text-amber-300 border border-amber-500 px-5 py-2.5 rounded-full shadow-2xl flex items-center gap-2.5 text-xs sm:text-sm font-semibold">
