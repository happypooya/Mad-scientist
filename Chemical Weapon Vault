<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>The Portrait Vault - Mystery Puzzle Game</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Plus+Jakarta+Sans:wght@400;600;700&family=Special+Elite&display=swap" rel="stylesheet">

    <style>
        :root {
            --gold-primary: #d4af37;
            --gold-light: #f3e5ab;
            --gold-dark: #aa7c11;
            --wood-dark: #1f140e;
            --wallpaper-bg: #140d12;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--wallpaper-bg);
            color: #e2e8f0;
            overflow-x: hidden;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }

        .font-cinzel {
            font-family: 'Cinzel', serif;
        }

        .font-clue {
            font-family: 'Special Elite', cursive;
        }

        /* Victorian Wallpaper Pattern */
        .museum-wall {
            background-color: #1a0f16;
            background-image: 
                radial-gradient(circle at 50% 30%, rgba(212, 175, 55, 0.15) 0%, transparent 60%),
                radial-gradient(circle at 20% 80%, rgba(139, 0, 0, 0.2) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(139, 0, 0, 0.2) 0%, transparent 50%),
                repeating-linear-gradient(45deg, rgba(30, 15, 25, 0.5) 0px, rgba(30, 15, 25, 0.5) 20px, rgba(10, 5, 10, 0.5) 20px, rgba(10, 5, 10, 0.5) 40px);
            box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.9);
        }

        /* Gold Frame Styling */
        .picture-frame {
            position: relative;
            background: linear-gradient(135deg, #f5d77f 0%, #b8860b 25%, #ffd700 50%, #8b6508 75%, #d4af37 100%);
            border-radius: 10px;
            padding: 6px;
            box-shadow: 
                0 10px 20px rgba(0, 0, 0, 0.8),
                0 0 10px rgba(212, 175, 55, 0.2),
                inset 0 0 6px rgba(0, 0, 0, 0.8);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
        }

        .picture-frame:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 
                0 15px 30px rgba(0, 0, 0, 0.9),
                0 0 20px rgba(243, 229, 171, 0.4);
        }

        .picture-frame.in-slot {
            opacity: 0.35;
            filter: grayscale(0.6);
            transform: scale(0.95);
        }

        .inner-canvas {
            background: radial-gradient(circle, #3a2b37 0%, #170d19 100%);
            border: 2px solid #2a1a08;
            border-radius: 5px;
            overflow: hidden;
            box-shadow: inset 0 0 15px rgba(0,0,0,0.9);
        }

        /* Slot Drop Area Styling */
        .pedestal-slot {
            background: rgba(15, 10, 20, 0.85);
            border: 2px dashed #b8860b;
            border-radius: 10px;
            transition: all 0.3s ease;
            box-shadow: inset 0 0 12px rgba(0,0,0,0.8);
        }

        /* Wall Opening Mechanism Animations */
        .wall-panel {
            transition: transform 2.2s cubic-bezier(0.77, 0, 0.175, 1);
            will-change: transform;
        }

        .wall-left.open {
            transform: translateY(-120%);
        }

        /* Vault Door Glow Effects */
        @keyframes vaultGlow {
            0%, 100% { filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.3)); }
            50% { filter: drop-shadow(0 0 30px rgba(212, 175, 55, 0.7)); }
        }

        .vault-door-container {
            animation: vaultGlow 3s infinite ease-in-out;
        }

        /* Torch Flicker */
        @keyframes torchLight {
            0%, 100% { opacity: 0.85; transform: scale(1); }
            25% { opacity: 1; transform: scale(1.03); }
            50% { opacity: 0.75; transform: scale(0.97); }
            75% { opacity: 0.95; transform: scale(1.02); }
        }

        .light-glow {
            animation: torchLight 2.5s infinite ease-in-out;
        }

        /* AI Companion Pulse & Glow */
        @keyframes aiPulse {
            0%, 100% { box-shadow: 0 0 15px rgba(59, 130, 246, 0.5), 0 0 30px rgba(147, 197, 253, 0.2); }
            50% { box-shadow: 0 0 25px rgba(59, 130, 246, 0.8), 0 0 45px rgba(147, 197, 253, 0.5); }
        }

        .ai-avatar-glow {
            animation: aiPulse 3s infinite ease-in-out;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #1f140e;
        }
        ::-webkit-scrollbar-thumb {
            background: #8b6508;
            border-radius: 3px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between relative bg-black text-slate-100 select-none overflow-x-hidden">

